# Development only. Copy to .env at the repository root and replace placeholders.
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=sdu_campus_assistant
POSTGRES_USER=sdu_campus_app
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_SSLMODE=disable
# Optional: OAuth 2.0 Web client ID from Google Cloud Console (Credentials).
# Add http://127.0.0.1:5173 and http://localhost:5173 as Authorized JavaScript origins.
GOOGLE_OAUTH_CLIENT_ID=
