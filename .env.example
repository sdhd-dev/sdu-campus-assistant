# Development only. Copy to .env at the repository root and replace placeholders.
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=sdu_campus_assistant
POSTGRES_USER=sdu_campus_app
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_SSLMODE=disable
# Optional: OAuth 2.0 Web client ID from Google Cloud Console (Credentials).
# Add http://127.0.0.1:5173 and http://localhost:5173 as Authorized JavaScript origins.
GOOGLE_OAUTH_CLIENT_ID=

# University status verification by email code. Comma-separated exact domains,
# without "@"; subdomains are not included. Leave both empty to hide the feature.
# SDU uses one domain for everyone: put sdu.edu.kz in both lists. The code then
# proves the address is SDU's, and the user chooses Student or Staff.
UNIVERSITY_STUDENT_DOMAINS=
UNIVERSITY_STAFF_DOMAINS=

# Email delivery for verification codes.
# Development: leave EMAIL_BACKEND empty and codes are printed in the runserver terminal.
# Demo with Gmail: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend,
# EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=true,
# EMAIL_HOST_USER=<the Gmail address>, EMAIL_HOST_PASSWORD=<16-character app password
# from myaccount.google.com/apppasswords; needs 2-Step Verification on that account>,
# DEFAULT_FROM_EMAIL=SDU Campus Assistant <the same Gmail address>
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
